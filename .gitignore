# MySQL Data Files
mysql-data/
generated/

# Database backups. These default to ~/.tops/backups (outside the repo) — see
# TOPS_BACKUP_DIR in .env.docker.example — but a physical MySQL backup is a
# byte-for-byte copy of the database, so cover the in-repo paths too in case
# anyone points TOPS_BACKUP_DIR at a relative directory.
backups/
.tops/
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

#outputs from tests
outputs
vendor
references/*/vendor

#no .env file
/infra/scripts/prod/app.env
/infra/scripts/test/app.env

/.topsbuild/

# SAM build output. Regenerated by `sam build` in
# docker/installer/scripts/install-messaging.sh:62, so it is never source.
#
# It was tracked until 2026-07-30, which broke `git pull` for anyone who had run
# the installer: sam runs inside a container as root and writes here through a
# bind mount, so git ends up unable to modify tracked files the user does not own
# ("unable to unlink old ... Permission denied"). Untracking it removes that
# whole class of failure.
.aws-sam/