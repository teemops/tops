# Managed by tops

server {
        listen 80 default_server;
        listen [::]:80 default_server ipv6only=on;
        server_name localhost;

        root /usr/share/nginx/html;
        index index.php index.html index.htm;

        # Laravel-specific configuration (fix for pretty URLs, handle front controller)
        location / {
                try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
                include snippets/fastcgi-php.conf;
                fastcgi_pass unix:/run/php/php-fpm.sock;

                # Laravel: Increase timeout for long requests (queues, artisan, etc.)
                fastcgi_read_timeout 300;

                # Laravel: Prevent access to .env and other sensitive files
                location ~ /\.(env|env\.example|git|ht|svn|user\.ini) {
                        deny all;
                }
        }

        location / {
                try_files $uri $uri/ =404;
        }

        // (Removed location /api block as it is not required for php-fpm)

        location /rc- {
                try_files $uri $uri/ =404;
        }
}
