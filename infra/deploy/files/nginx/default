# Managed by tops

server {
        listen 80 default_server;
        listen [::]:80 default_server ipv6only=on;
        server_name localhost;

        # Set root to Laravel's public directory
        # Update this path to match your actual Laravel deployment location
        # Example: /var/www/app/public or /home/ubuntu/app/public
        root /srv/apps/tops/app/public;
        index index.php index.html index.htm;

        # Laravel: Prevent access to .env and other sensitive files
        location ~ /\.(env|env\.example|git|ht|svn|user\.ini) {
                deny all;
        }

        # Laravel-specific configuration (fix for pretty URLs, handle front controller)
        location / {
                try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
                include snippets/fastcgi-php.conf;
                fastcgi_pass unix:/run/php/php-fpm.sock;

                # Laravel: Increase timeout for long requests (queues, artisan, etc.)
                fastcgi_read_timeout 300;
        }

        location /rc- {
                try_files $uri $uri/ =404;
        }
}
