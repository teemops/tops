{
    "$schema": "tops/scan/tasks/schema.v1",
    "name": "tasks.json",
    "description": "Tasks for auditing AWS KMS resources",
    "config": {
        "service": "kms",
        "label": "KMS",
        "client": "kms",
        "regional": true,
        "profiles": [
            "basic",
            "cis",
            "pci"
        ],
        "start": "listKeys",
        "defaults": {
            "actions": {
                "params": {
                    "KeyId": "$item['KeyId']"
                }
            }
        }
    },
    "tasks": [
        {
            "listKeys": {
                "task": "listKeys",
                "id": "key",
                "key": "KeyId",
                "description": "List all KMS keys",
                "actions": [
                    {
                        "describeKey": {
                            "params": {
                                "KeyId": "$item['KeyId']"
                            }
                        }
                    },
                    {
                        "getKeyRotationStatus": {
                            "params": {
                                "KeyId": "$item['KeyId']"
                            }
                        }
                    }
                ],
                "items": {
                    "Keys": [
                        {
                            "Name": "KeyId",
                            "Type": "String"
                        },
                        {
                            "Name": "KeyArn",
                            "Type": "String"
                        }
                    ]
                }
            }
        }
    ]
}
