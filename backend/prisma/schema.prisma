// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String?
  defaultOrgId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
  scans         Scan[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  orgId     String   @unique @default(uuid())
  userId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  awsAccounts AwsAccount[]
  scans       Scan[]

  @@map("organizations")
}

model AwsAccount {
  id           String    @id @default(uuid())
  name         String
  awsAccountId String
  iamRoleArn   String    // Encrypted
  externalId   String    @unique
  uniqueId     String    @unique
  organizationId String
  status       String    @default("pending") // pending, active, error
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastScanAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)
  scans         Scan[]

  @@unique([organizationId, awsAccountId])
  @@map("aws_accounts")
}

model Scan {
  id           String    @id @default(uuid())
  awsAccountId String
  organizationId String
  userId       String
  scanType     String    @default("full") // full, quick
  status       String    @default("pending") // pending, running, completed, failed, cancelled
  findingsCount Int      @default(0)
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?

  awsAccount   AwsAccount   @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [orgId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results      ScanResult[]

  @@map("scans")
}

model ScanResult {
  id                    String   @id @default(uuid())
  scanId                String
  title                 String
  description           String   @db.Text
  severity              String   // critical, high, medium, low, info
  service               String   // s3, iam, ec2, rds
  resourceId            String
  resourceType          String
  resourceArn           String?
  status                String   @default("open") // open, resolved, ignored
  complianceFrameworks  String   // JSON array
  remediation           String   @db.Text
  evidence              String   @db.Text // JSON
  comment               String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("scan_results")
}
