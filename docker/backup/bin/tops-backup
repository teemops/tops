#!/usr/bin/env bash
#
# tops-backup — the three backup tiers, plus retention and reporting.
#
#   tops-backup full     daily 5pm  : complete physical copy of the datadir
#   tops-backup diff     hourly     : pages changed since the last FULL
#   tops-backup binlog   15 minutes : archive of closed binary logs
#   tops-backup prune               : retention enforcement
#   tops-backup list                : inventory
#   tops-backup status              : one-line health summary
#
# "diff" is a differential, not an incremental: every differential is based on
# the most recent full, never on the previous differential. That is a
# deliberate trade — each hourly backup is a little larger than a pure
# incremental would be, but recovery only ever applies ONE delta on top of the
# full, so a single corrupt or missing hourly cannot break the recovery of any
# other hour. With a chain of incrementals, losing hour 3 loses hours 3-23 too.

# shellcheck source=../lib/common.sh
source /opt/tops-backup/lib/common.sh

# ---------------------------------------------------------------------------

do_full() {
    LOG_TAG=full
    local stamp target
    stamp=$(new_stamp)
    target="$FULL_DIR/$stamp"

    log "starting full backup -> $target"
    wait_for_mysql 120

    # --no-server-version-check: XtraBackup 8.0.35 warns off servers newer than
    # itself. mysql:8.0 floats ahead of the last 8.0 XtraBackup release, and the
    # on-disk format is unchanged within the 8.0 series, so the check is a
    # false positive here. Remove it if the server ever moves to 8.4+ — at that
    # point the correct fix is a matching XtraBackup, not skipping the check.
    if ! xtrabackup --defaults-file="$DEFAULTS_FILE" \
            --backup \
            --datadir="$DATADIR" \
            --target-dir="$target" \
            --no-server-version-check; then
        warn "full backup failed; removing partial $target"
        rm -rf "$target"
        return 1
    fi

    write_meta "$target" full
    reown "$target"
    log "full backup complete: $(du -sh "$target" | cut -f1) at binlog $(meta_get "$target" binlog_file):$(meta_get "$target" binlog_pos)"
}

do_diff() {
    LOG_TAG=diff
    local base
    base=$(latest_backup full)

    if [[ -z $base ]]; then
        log "no full backup exists yet; promoting this run to a full backup"
        do_full
        return
    fi

    local stamp target
    stamp=$(new_stamp)
    target="$DIFF_DIR/$stamp"

    log "starting differential backup -> $target (base: $(basename "$base"))"
    wait_for_mysql 120

    if ! xtrabackup --defaults-file="$DEFAULTS_FILE" \
            --backup \
            --datadir="$DATADIR" \
            --target-dir="$target" \
            --incremental-basedir="$base" \
            --no-server-version-check; then
        warn "differential backup failed; removing partial $target"
        rm -rf "$target"
        return 1
    fi

    write_meta "$target" diff "$(basename "$base")"
    reown "$target"
    log "differential complete: $(du -sh "$target" | cut -f1) at binlog $(meta_get "$target" binlog_file):$(meta_get "$target" binlog_pos)"
}

# ---------------------------------------------------------------------------
# Binlog archiving — the transactional tier.
#
# FLUSH BINARY LOGS closes the file MySQL is currently writing and opens a new
# one. Every file except the newly opened one is then final and immutable, so
# copying it is safe: there is no torn read and no need to coordinate with the
# server. Copying the *active* file instead would be the classic mistake — it
# can be mid-event, and replaying a truncated event aborts a PITR restore.
#
# The upshot is that every 15-minute tick makes all transactions committed
# before that tick recoverable, which is exactly a 15-minute RPO.
# ---------------------------------------------------------------------------

do_binlog() {
    LOG_TAG=binlog
    wait_for_mysql 60
    mkdir -p "$BINLOG_DIR"

    mysql_q -e "FLUSH BINARY LOGS" \
        || die "FLUSH BINARY LOGS failed (backup user needs RELOAD)"

    local -a logs=()
    mapfile -t logs < <(mysql_q -e "SHOW BINARY LOGS" | awk '{print $1}')
    (( ${#logs[@]} > 1 )) || { log "no closed binary logs to archive"; return 0; }

    # Drop the last entry: that is the file FLUSH just opened, still active.
    unset 'logs[${#logs[@]}-1]'

    local copied=0 f src dst
    for f in "${logs[@]}"; do
        src="$DATADIR/$f"
        dst="$BINLOG_DIR/$f"

        # Already purged by binlog_expire_logs_seconds before we got to it.
        [[ -f $src ]] || continue

        if [[ -f $dst ]]; then
            if [[ $(stat -c%s "$dst") -eq $(stat -c%s "$src") ]]; then
                continue    # already archived, closed files never change
            fi
            # Same name, different content: the server's binlog counter has
            # restarted (a `docker compose down -v`, or a restore that reset
            # the index). Overwriting would destroy the only copy of the old
            # transaction stream, so retire the archive instead of losing it.
            rotate_binlog_archive
            dst="$BINLOG_DIR/$f"
        fi

        cp -p "$src" "$dst.part" && mv "$dst.part" "$dst"
        copied=$(( copied + 1 ))
    done

    # binlog.index is not needed to replay, but it records the server's own
    # view of the sequence and makes a truncated archive obvious.
    [[ -f "$DATADIR/binlog.index" ]] && cp -p "$DATADIR/binlog.index" "$BINLOG_DIR/binlog.index"

    reown "$BINLOG_DIR"
    log "archived $copied new binary log file(s); archive holds $(ls -1 "$BINLOG_DIR" | grep -cE '\.[0-9]{6,}$') file(s), $(du -sh "$BINLOG_DIR" | cut -f1)"
}

rotate_binlog_archive() {
    local retired="$BACKUP_ROOT/binlog.superseded.$(new_stamp)"
    warn "binary log sequence restarted on the server (new server generation)."
    warn "retiring the existing archive to $retired so nothing is overwritten."
    warn "point-in-time recovery across that boundary needs the retired archive."
    mv "$BINLOG_DIR" "$retired"
    mkdir -p "$BINLOG_DIR"
    reown "$retired"
}

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

do_prune() {
    LOG_TAG=prune
    local -a fulls=()
    mapfile -t fulls < <(list_backups full)
    (( ${#fulls[@]} )) || { log "nothing to prune"; return 0; }

    # Always keep the newest full even if it is older than the retention
    # window. A quiet scheduler must never leave the system with zero
    # recoverable backups.
    local keep_after cutoff removed=0 d
    cutoff=$(date -d "-${FULL_RETENTION_DAYS} days" '+%Y%m%dT%H%M%S')
    keep_after="${fulls[-1]}"

    for d in "${fulls[@]}"; do
        [[ $d == "$keep_after" ]] && continue
        if [[ $(basename "$d") < $cutoff ]]; then
            log "removing expired full $(basename "$d")"
            rm -rf "$d"
            removed=$(( removed + 1 ))
        fi
    done

    # A differential is worthless without its base, so it dies with it.
    local base
    while read -r d; do
        [[ -n $d ]] || continue
        base=$(meta_get "$d" base || true)
        if [[ -z $base || ! -d "$FULL_DIR/$base" ]]; then
            log "removing orphaned differential $(basename "$d") (base $base is gone)"
            rm -rf "$d"
            removed=$(( removed + 1 ))
        fi
    done < <(list_backups diff)

    prune_binlogs
    log "prune complete; removed $removed backup(s)"
}

prune_binlogs() {
    # The floor: the binlog named by the OLDEST surviving full backup. Deleting
    # anything at or after that point would make that full unrecoverable to any
    # time other than the instant it was taken — which is the whole reason the
    # hourly and 15-minute tiers exist. Time-based expiry only applies below
    # this floor, never through it.
    local oldest_full floor_file floor_seq
    oldest_full=$(list_backups full | head -n1)
    [[ -n $oldest_full ]] || return 0

    floor_file=$(meta_get "$oldest_full" binlog_file || true)
    if [[ -z $floor_file ]]; then
        warn "oldest full $(basename "$oldest_full") records no binlog position; skipping binlog prune"
        return 0
    fi
    floor_seq=$(binlog_seq "$floor_file")

    local cutoff_epoch removed=0 f
    cutoff_epoch=$(date -d "-${BINLOG_RETENTION_DAYS} days" '+%s')

    for f in "$BINLOG_DIR"/*.[0-9]*; do
        [[ -f $f ]] || continue
        (( $(binlog_seq "$(basename "$f")") < floor_seq )) || continue
        (( $(stat -c%Y "$f") < cutoff_epoch ))            || continue
        rm -f "$f"
        removed=$(( removed + 1 ))
    done
    (( removed )) && log "removed $removed archived binary log file(s) older than $floor_file"
    return 0
}

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

do_list() {
    local d
    echo "FULL BACKUPS (base for recovery)"
    if [[ -z $(list_backups full) ]]; then
        echo "  (none)"
    else
        while read -r d; do
            printf '  %-18s %8s  binlog %s:%s\n' \
                "$(basename "$d")" "$(du -sh "$d" | cut -f1)" \
                "$(meta_get "$d" binlog_file)" "$(meta_get "$d" binlog_pos)"
        done < <(list_backups full)
    fi

    echo
    echo "DIFFERENTIALS (hourly, each applies directly onto its base full)"
    if [[ -z $(list_backups diff) ]]; then
        echo "  (none)"
    else
        while read -r d; do
            printf '  %-18s %8s  base %-18s binlog %s:%s\n' \
                "$(basename "$d")" "$(du -sh "$d" | cut -f1)" \
                "$(meta_get "$d" base)" \
                "$(meta_get "$d" binlog_file)" "$(meta_get "$d" binlog_pos)"
        done < <(list_backups diff)
    fi

    echo
    echo "ARCHIVED BINARY LOGS (15 min, transaction stream for PITR)"
    local n
    n=$(ls -1 "$BINLOG_DIR" 2>/dev/null | grep -cE '\.[0-9]{6,}$' || true)
    if [[ ${n:-0} -eq 0 ]]; then
        echo "  (none)"
    else
        printf '  %s file(s), %s, %s .. %s\n' "$n" "$(du -sh "$BINLOG_DIR" | cut -f1)" \
            "$(ls -1 "$BINLOG_DIR" | grep -E '\.[0-9]{6,}$' | sort -t. -k2,2n | head -n1)" \
            "$(ls -1 "$BINLOG_DIR" | grep -E '\.[0-9]{6,}$' | sort -t. -k2,2n | tail -n1)"
    fi
}

do_status() {
    local full diff n_binlog latest_binlog_mtime
    full=$(latest_backup full)
    diff=$(latest_backup diff)
    n_binlog=$(ls -1 "$BINLOG_DIR" 2>/dev/null | grep -cE '\.[0-9]{6,}$' || echo 0)

    echo "backup root      : $BACKUP_ROOT ($(du -sh "$BACKUP_ROOT" 2>/dev/null | cut -f1))"
    echo "timezone         : ${TZ:-UTC}  ($(date '+%Y-%m-%d %H:%M:%S %Z'))"
    echo "latest full      : ${full:+$(basename "$full") ($(meta_get "$full" created_at))}${full:-none}"
    echo "latest diff      : ${diff:+$(basename "$diff") ($(meta_get "$diff" created_at))}${diff:-none}"
    if (( n_binlog )); then
        latest_binlog_mtime=$(find "$BINLOG_DIR" -name '*.[0-9]*' -printf '%T@ %p\n' | sort -rn | head -n1 | cut -d' ' -f2-)
        echo "binlog archive   : $n_binlog file(s), newest $(basename "$latest_binlog_mtime") at $(date -d "@$(stat -c%Y "$latest_binlog_mtime")" '+%Y-%m-%d %H:%M:%S')"
    else
        echo "binlog archive   : none"
    fi
    echo "retention        : fulls ${FULL_RETENTION_DAYS}d, binlogs ${BINLOG_RETENTION_DAYS}d (never below the oldest full)"
}

# ---------------------------------------------------------------------------

ensure_layout

case "${1:-}" in
    full)   with_lock physical do_full   ;;
    diff)   with_lock physical do_diff   ;;
    binlog) with_lock binlog   do_binlog ;;
    prune)  with_lock physical do_prune  ;;
    list)   do_list   ;;
    status) do_status ;;
    *)
        cat >&2 <<'USAGE'
usage: tops-backup {full|diff|binlog|prune|list|status}

  full     complete physical backup of the datadir (daily tier)
  diff     pages changed since the latest full     (hourly tier)
  binlog   archive closed binary logs              (15-minute tier)
  prune    apply retention to fulls, diffs, binlogs
  list     inventory of everything recoverable
  status   one-screen health summary
USAGE
        exit 64
        ;;
esac
